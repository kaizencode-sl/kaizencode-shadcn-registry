---
export interface Props {
  title: string
  description: string
  registryName: string
}

const { title, description, registryName } = Astro.props
const installCommand = `pnpm dlx shadcn@latest add @kaizencode/${registryName}`
---

<article class="min-w-0 rounded-lg border bg-card text-card-foreground shadow-sm">
  <div class="p-4 sm:p-5">
    <h3 class="font-medium leading-none tracking-tight">{title}</h3>
    <p class="mt-1.5 text-sm text-muted-foreground">{description}</p>
    <div class="mt-4">
      <slot />
    </div>
  </div>
  <div class="border-t px-4 py-3 sm:px-5 sm:py-4">
    <p class="text-xs font-medium text-muted-foreground">Installation</p>
    <div class="relative mt-2">
      <pre class="max-w-full overflow-x-auto rounded-lg border bg-muted/50 p-3 text-xs"><code>{installCommand}</code></pre>
    </div>
  </div>
</article>
