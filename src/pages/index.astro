---
import ComponentCard from "@/components/component-card.astro"
import Layout from "@/layouts/main.astro"
import { DevelopedByKaizencode } from "@/components/ui/developed-by-kaizencode"
---

<Layout>
  <div class="flex min-h-dvh flex-col">
    <main class="flex-1">
      <div class="mx-auto w-full max-w-2xl px-4 py-12 sm:px-6 sm:py-16 lg:py-24">
        <div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
            Kaizencode Registry
          </h1>
          <p class="mt-3 text-muted-foreground">
            A shadcn/ui registry for custom components. Use them in any shadcn project via the CLI.
          </p>
        </div>

        <section class="mt-12 sm:mt-16">
          <h2 class="mb-5 text-lg font-semibold">Components</h2>

          <div class="grid gap-5">
            <ComponentCard
              title="developed-by-kaizencode"
              description="A footer component with Kaizencode branding."
              registryName="developed-by-kaizencode"
            >
              <DevelopedByKaizencode className="justify-start rounded-md bg-muted/50 p-3" />
            </ComponentCard>
          </div>
        </section>
      </div>
    </main>
    <DevelopedByKaizencode />
  </div>
</Layout>
