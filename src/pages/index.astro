---
import Layout from "@/layouts/main.astro"
import { DevelopedByKaizencode } from "@/components/ui/developed-by-kaizencode"
---

<Layout>
  <div class="flex min-h-svh flex-col">
    <main class="flex-1 p-6">
      <div class="mx-auto max-w-2xl">
        <h1 class="mb-2 text-3xl font-bold">Kaizencode Registry</h1>
        <p class="mb-8 text-muted-foreground">
          A shadcn/ui registry for custom components. Use them in any shadcn
          project via the CLI.
        </p>

        <h2 class="mb-4 text-xl font-semibold">Available Components</h2>

        <div class="grid gap-4">
          <div class="rounded-lg border p-4">
            <h3 class="font-medium">developed-by-kaizencode</h3>
            <p class="mt-1 text-sm text-muted-foreground">
              A footer component with Kaizencode branding.
            </p>
            <DevelopedByKaizencode className="mt-3 justify-start rounded-lg border bg-muted/50 p-3" />
          </div>
        </div>

        <div class="mt-8 rounded-lg border bg-muted/50 p-4">
          <h3 class="text-sm font-medium">Usage</h3>
          <pre
            class="mt-2 overflow-x-auto rounded-lg border bg-background p-3 text-sm"><code>npx shadcn@latest add developed-by-kaizencode \
  --registry https://github.com/kaizencode-sl/kaizencode-shadcn-registry</code></pre>
        </div>
      </div>
    </main>
    <DevelopedByKaizencode />
  </div>
</Layout>
