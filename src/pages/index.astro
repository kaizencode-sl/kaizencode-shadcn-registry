---
import ComponentCard from "@/components/component-card.astro"
import Layout from "@/layouts/main.astro"
import { DevelopedByKaizencode } from "@/components/ui/developed-by-kaizencode"
---

<Layout>
  <div class="flex min-h-svh flex-col">
    <main class="flex-1 p-6">
      <div class="mx-auto max-w-2xl">
        <h1 class="mb-2 text-3xl font-bold">Kaizencode Registry</h1>
        <p class="mb-8 text-muted-foreground">
          A shadcn/ui registry for custom components. Use them in any shadcn
          project via the CLI.
        </p>

        <h2 class="mb-4 text-xl font-semibold">Components</h2>

        <div class="grid gap-4">
          <ComponentCard
            title="developed-by-kaizencode"
            description="A footer component with Kaizencode branding."
            registryName="developed-by-kaizencode"
          >
            <DevelopedByKaizencode className="justify-start rounded-lg border bg-muted/50 p-3" />
          </ComponentCard>
        </div>
      </div>
    </main>
    <DevelopedByKaizencode />
  </div>
</Layout>
